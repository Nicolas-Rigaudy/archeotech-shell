/* Generated by theme-switch.py — palette: {{name}}
 * DO NOT EDIT — regenerated on every theme switch.
 * Imported by userChrome.css.
 *
 * COLORS only, and DELIBERATELY LIGHT-TOUCH. We do NOT paint solid backgrounds
 * on the chrome containers — that flattens Zen's per-workspace GRADIENT into one
 * flat fill (dark palettes like Monochrome → flat black). Zen owns its chrome
 * appearance via its workspace theme/gradient (stored in the `zen_workspaces`
 * DB, set in Zen's UI); userChrome can't cleanly override it. So we only nudge
 * palette VARIABLES + text colors here; making Zen's chrome actually FOLLOW the
 * shell theme means driving the workspace gradient from the palette during the
 * restart window — a queued feature (see ROADMAP theme-packs / Sprint 26).
 * Transparency is MangoWC's job (per-window opacity on appid:zen). */

:root {
  --arch-base:     {{base}};
  --arch-mantle:   {{mantle}};
  --arch-crust:    {{crust}};
  --arch-surface0: {{surface0}};
  --arch-text:     {{text}};
  --arch-accent:   {{mauve}};

  /* Accent + text tints (don't fight the gradient; these color buttons,
   * borders, active states, and text). */
  --zen-primary-color:      {{mauve}} !important;
  --lwt-text-color:         {{text}} !important;
  --toolbar-color:          {{text}} !important;
  --tab-selected-textcolor: {{text}} !important;
  --toolbar-field-color:    {{text}} !important;

  /* Context menus / popups — the "square white frame" around the rounded menu
   * is Firefox's default popup border/backdrop. Kill the border entirely and
   * palette the fill; these are standard Firefox chrome (not Zen's gradient),
   * so userChrome styles them reliably. */
  --panel-background:      {{mantle}} !important;
  --panel-color:           {{text}} !important;
  --panel-border-color:    transparent !important;
  --panel-shadow-margin:   0 !important;
  --menu-background-color: {{mantle}} !important;
  --menu-color:            {{text}} !important;
}

/* The white "square" is the popup's backing window surface (white by default on
 * Wayland). We can't round the actual window, so COVER it with the dark fill
 * (opaque, no border) — the square corners then read as dark menu, not white.
 * Do NOT set background:transparent here — that just reveals the white surface. */
/* ONE uniform dark fill on the outer popup + EVERYTHING inside transparent, so
 * there's no two-tone (the grey body was `.menupopup-arrowscrollbox` keeping its
 * default while only the outer frame took our color). radius 0 = fills the
 * square popup window edge-to-edge, no corner mismatch. */
menupopup,
panel {
  --panel-border-color: transparent !important;
  --panel-border-radius: 0 !important;
  --panel-background: {{mantle}} !important;
  --menu-background-color: {{mantle}} !important;
  --menu-color: {{text}} !important;
  border: none !important;
  background-color: {{mantle}} !important;
  color: {{text}} !important;
}
menupopup::part(content),
panel::part(content),
.menupopup-arrowscrollbox,
menupopup > menuitem,
menupopup > menu,
menucaption {
  background-color: transparent !important;
  border: none !important;
  border-radius: 0 !important;
}
menupopup > menuitem[_moz-menuactive="true"],
menupopup > menu[_moz-menuactive="true"] {
  background-color: {{surface0}} !important;
}
menuseparator {
  border-color: {{surface0}} !important;
}
