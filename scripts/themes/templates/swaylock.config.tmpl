################################################################################
# SWAYLOCK CONFIGURATION  —  GENERATED by scripts/theme-switch.py
# Do not edit directly. Edit scripts/themes/templates/swaylock.config.tmpl,
# then re-run a theme switch. Colors come from the active theme.json.
################################################################################

# Display settings
ignore-empty-password
show-failed-attempts
show-keyboard-layout

# Wallpaper is passed dynamically via --image flag in swayidle config
# (reads from ~/.cache/wallpaper/last-wallpaper at lock time)
scaling=fill

# Font
font=FiraCode Nerd Font
font-size=30

# Indicator settings (centered on screen with larger radius)
# (upstream swaylock: `indicator-idle-visible` = the fork's bare `indicator`)
indicator-idle-visible
indicator-caps-lock
indicator-radius=140
indicator-thickness=20

# NOTE (2026-07-03): switched swaylock-effects → upstream swaylock (the fork
# segfaulted on resume — see TROUBLESHOOTING.md). Upstream errors on unknown
# options, so the effects-only settings were removed: clock/timestr/datestr,
# effect-blur/effect-vignette, grace/grace-no-mouse/grace-no-touch, fade-in.
# (Upstream locks immediately by default, so grace=0 needed no replacement.)
# Want blur + clock back? hyprlock is the maintained option (already configured
# for Hyprland) — would need its own template/format.

################################################################################
# COLORS — substituted from the active theme (hex without leading '#').
# Transparent fields (00000000) stay fixed for the glass look.
################################################################################

color={{base}}
bs-hl-color={{rosewater}}
caps-lock-bs-hl-color={{rosewater}}
caps-lock-key-hl-color={{green}}
inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000
key-hl-color={{green}}
layout-bg-color=00000000
layout-border-color=00000000
layout-text-color={{text}}
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
ring-color={{lavender}}
ring-clear-color={{rosewater}}
ring-caps-lock-color={{peach}}
ring-ver-color={{blue}}
ring-wrong-color={{maroon}}
separator-color=00000000
text-color={{text}}
text-clear-color={{rosewater}}
text-caps-lock-color={{peach}}
text-ver-color={{blue}}
text-wrong-color={{maroon}}
