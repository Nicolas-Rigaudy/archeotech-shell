################################################################################
# HYPRLOCK CONFIGURATION  —  GENERATED by scripts/theme-switch.py
# Do not edit directly. Edit scripts/themes/templates/hyprlock.conf.tmpl,
# then re-run a theme switch. Colors come from the active theme.json.
#
# hyprlock replaced swaylock (2026-07-08): a separately-maintained codebase (not
# the sway lineage) that fixes the resume-freeze segfault AND restores blur.
# hyprlock reads this file fresh on every launch, so no reload is needed.
#
# Design ("Console" frame): cinematic blurred+vignetted wallpaper; a thin,
# oversized clock (FiraCode Light) + date up top; an understated frosted input
# with an accent underline; everything else collapsed into one quiet bottom
# status bar (user · layout · battery · uptime, via scripts/hyprlock-info.sh).
################################################################################

# ── Fonts + colors (hyprlang vars; hex WITHOUT '#', wrapped in rgb()/rgba()) ──
$font    = FiraCode Nerd Font
$fontlt  = FiraCode Nerd Font Light
$text    = rgb({{text}})
$subtext = rgb({{subtext0}})
$accent  = rgb({{lavender}})
$shadow  = rgba({{crust}}cc)
$fail    = rgba({{maroon}}4d)

general {
    hide_cursor = true
    grace = 0
    ignore_empty_input = true
}

# Wallpaper: static path → a symlink wallpaper-set.sh repoints to the current
# wallpaper. Blur + dim + vignette + subtle vibrancy make it cinematic.
background {
    monitor =
    path = $HOME/.cache/wallpaper/current
    blur_passes = 3
    blur_size = 4
    noise = 0.0117
    contrast = 0.9
    brightness = 0.8
    vibrancy = 0.17
    vignette = 0.4
}

animations {
    enabled = true
    bezier = smooth, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 4, smooth
}

# Accent underline beneath the input (drawn before it so it tucks under the
# field's bottom edge — the "Panel" accent, minus the boxy ring).
shape {
    monitor =
    size = 300, 2
    color = $accent
    rounding = 1
    border_size = 0
    position = 0, -30
    halign = center
    valign = center
}

# Understated frosted input — no full outline, just a translucent field + the
# underline above. fail_text carries wrong-password feedback.
input-field {
    monitor =
    size = 340, 54
    rounding = 10
    outline_thickness = 0
    dots_size = 0.24
    dots_spacing = 0.28
    dots_center = true
    inner_color = rgba(00000000)
    font_color = $text
    check_color = rgba(00000000)
    fail_color = $fail
    fail_text = Wrong — $ATTEMPTS attempt(s)
    fail_transition = 100
    fade_on_empty = false
    placeholder_text =
    shadow_passes = 2
    shadow_size = 5
    shadow_color = $shadow
    shadow_boost = 1.2
    position = 0, 0
    halign = center
    valign = center
}

# Clock (HH:MM) — thin + oversized, the hero
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = $text
    font_size = 130
    font_family = $fontlt
    shadow_passes = 0
    position = 0, 190
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = $subtext
    font_size = 17
    font_family = $font
    shadow_passes = 0
    position = 0, 92
    halign = center
    valign = center
}

# Rotating phrase (dev/inspiration, re-picked each lock + every 2 min)
label {
    monitor =
    text = cmd[update:120000] hyprlock-info.sh phrase
    color = $subtext
    font_size = 15
    font_family = $font
    shadow_passes = 0
    position = 0, 48
    halign = center
    valign = center
}

# Bottom status bar: user · layout · battery · uptime (via helper)
label {
    monitor =
    text = cmd[update:30000] hyprlock-info.sh status
    color = $subtext
    font_size = 14
    font_family = $font
    shadow_passes = 0
    position = 0, 45
    halign = center
    valign = bottom
}
