{
  "_comment": "Shadow Spears — WH40K cyber-monastic dataslate. Deliberate grimdark pack palette (NOT Catppuccin): bone/umber/near-black with IMPERIAL GOLD as the working accent + oxblood red, and amethyst kept only as a heraldry touch. Gold gothic filigree at frame corners (no glow, no plain brackets). Weightier 'ritual' motion. Open/non-IP assets only. See docs/THEME_PACK.md.",
  "accent": "yellow",
  "colors": {
    "base": "#14110d", "mantle": "#0f0c09", "crust": "#0a0806",
    "surface0": "#241e17", "surface1": "#31281e", "surface2": "#42372a",
    "text": "#dccba6", "subtext1": "#bcab86", "subtext0": "#8f8163",
    "overlay0": "#6f6350", "overlay1": "#867a62", "overlay2": "#9d8f70",
    "yellow": "#c8a44d", "peach": "#c8a44d",
    "red": "#9e2b2b", "maroon": "#9e2b2b",
    "green": "#7d8c5a", "mauve": "#7c5ba6"
  },
  "radius": { "sm": 1, "base": 2, "md": 3, "lg": 3, "xl": 4, "pill": 999 },
  "font": { "displayFamily": "Noto Serif" },
  "_font_note": "displayFamily is a stand-in serif (installed); drop a gothic/blackletter OFL face in fonts/ + set font.displayFile for a real one. Body stays mono for legibility.",
  "frame": { "cornerRadius": 2 },
  "window": { "cornerRadius": 0, "borderWidth": 0 },

  "fx": {
    "texture":   { "source": "textures/parchment.png", "opacity": 0.14 },
    "glow":      { "enabled": false },
    "brackets":  { "enabled": false },
    "ornaments": [ { "source": "ornaments/filigree.svg", "anchor": "corners", "size": 44, "opacity": 0.92 } ]
  },

  "anim": { "panel": 300, "effectsMed": 240, "spatialDefault": 560, "enter": 460, "exit": 220 },

  "configSchema": {
    "fx.texture.opacity":  { "type": "real", "label": "Parchment grain", "min": 0, "max": 0.4, "step": 0.02, "default": 0.14 },
    "window.cornerRadius": { "type": "int",  "label": "Window corner radius", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 0 }
  }
}
