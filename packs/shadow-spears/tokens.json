{
  "_comment": "Shadow Spears — WH40K ornate-ceremonial dataslate. Aged-COPPER heraldry over a grimdark bone/near-black palette (deliberate pack palette, NOT Catppuccin). Flat MATTE 'slab' material (no glass), gothic-arch copper corner ornaments, weightier 'ritual' motion, serif display headers. Open/non-IP assets only. See docs/THEME_PACK.md.",
  "accent": "peach",
  "colors": {
    "base": "#161009", "mantle": "#100b07", "crust": "#0a0705",
    "surface0": "#271d13", "surface1": "#34281a", "surface2": "#453626",
    "text": "#dccba6", "subtext1": "#bcab86", "subtext0": "#8f8163",
    "overlay0": "#6f6350", "overlay1": "#867a62", "overlay2": "#9d8f70",
    "peach": "#a8683c", "maroon": "#803f22",
    "yellow": "#b8873f", "red": "#9e2b2b",
    "green": "#7d8c5a", "teal": "#5f7a6a", "mauve": "#7c5ba6"
  },
  "radius": { "sm": 1, "base": 2, "md": 2, "lg": 3, "xl": 4, "pill": 999 },
  "font": { "displayFamily": "Noto Serif" },
  "_font_note": "displayFamily is a stand-in serif; drop a gothic/blackletter OFL face in fonts/ + set font.displayFile for the real one. Body stays mono for legibility.",
  "frame": { "cornerRadius": 2 },
  "window": { "cornerRadius": 0, "borderWidth": 0 },
  "material": "flat",

  "fx": {
    "glow":      { "enabled": false },
    "brackets":  { "enabled": false },
    "ornaments": [ { "source": "ornaments/gothic-corner.svg", "anchor": "corners", "size": 48, "opacity": 1.0 } ]
  },

  "anim": { "panel": 300, "effectsMed": 240, "spatialDefault": 560, "enter": 460, "exit": 220 },

  "configSchema": {
    "material": { "type": "enum", "label": "Material",
                  "options": [ { "value": "flat", "label": "Matte slab" }, { "value": "glass", "label": "Frosted glass" } ],
                  "default": "flat" },
    "window.cornerRadius": { "type": "int", "label": "Window corner radius", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 0 }
  }
}
